+  /** nextroute patch: band beyond the avoided edge in which an ordinary street is linked as well. */
+  private static final double AVOIDED_EDGE_BAND_METERS = Double.parseDouble(
+    System.getProperty("otp.linker.avoidedEdgeBandMeters", "25")
+  );
+
+  /**
+   * nextroute patch: a stop or an entrance whose links all end on avoided edges (see {@link
+   * LinkAvoidance}) gets one more link, to the nearest ordinary walkable street within
+   * {@link #AVOIDED_EDGE_BAND_METERS} of the avoided one. Runs after island pruning so the extra
+   * links cannot keep small islands alive (linking more edges before pruning did: a platform area
+   * that pruning used to drop survived and the walk to 오류동역 grew from 4 to 14 minutes).
+   */
+  public void addLinksAroundAvoidedEdges(Graph graph) {
+    int stops = 0;
+    int entrances = 0;
+    for (TransitStopVertex v : graph.getVerticesOfType(TransitStopVertex.class)) {
+      if (linkAroundAvoidedEdge(graph, v, sv -> createStopLinkEdges(v, sv))) {
+        stops++;
+      }
+    }
+    for (TransitEntranceVertex v : graph.getVerticesOfType(TransitEntranceVertex.class)) {
+      if (
+        linkAroundAvoidedEdge(graph, v, sv ->
+          List.of(
+            StreetTransitEntranceLink.createStreetTransitEntranceLink(v, sv),
+            StreetTransitEntranceLink.createStreetTransitEntranceLink(sv, v)
+          )
+        )
+      ) {
+        entrances++;
+      }
+    }
+    LOG.info(
+      "Linked around avoided edges: {} stops, {} entrances ({} avoided edges)",
+      stops,
+      entrances,
+      LinkAvoidance.size()
+    );
+  }
+
+  private boolean linkAroundAvoidedEdge(
+    Graph graph,
+    Vertex v,
+    java.util.function.Function<StreetVertex, List<Edge>> linkEdges
+  ) {
+    double nearest = Double.MAX_VALUE;
+    boolean linked = false;
+    for (Edge e : v.getOutgoing()) {
+      if (
+        !(e instanceof StreetTransitStopLink || e instanceof StreetTransitEntranceLink) ||
+        !(e.getToVertex() instanceof StreetVertex sv)
+      ) {
+        continue;
+      }
+      linked = true;
+      boolean anyWalkable = false;
+      for (Edge se : sv.getOutgoing()) {
+        if (se instanceof org.opentripplanner.street.model.edge.StreetEdge street && street.canTraverse(WALK_ONLY)) {
+          anyWalkable = true;
+          if (!LinkAvoidance.isAvoided(street)) {
+            return false;
+          }
+        }
+      }
+      if (!anyWalkable) {
+        return false;
+      }
+      nearest = Math.min(nearest, metres(v.getLat(), v.getLon(), sv.getLat(), sv.getLon()));
+    }
+    if (!linked) {
+      return false;
+    }
+    double reach = nearest + AVOIDED_EDGE_BAND_METERS;
+    double xscale = Math.cos(Math.toRadians(v.getLat()));
+    double reachDeg = reach / 110540.0;
+    var env = new org.locationtech.jts.geom.Envelope(v.getCoordinate());
+    env.expandBy(reachDeg / xscale, reachDeg);
+    double best = Double.MAX_VALUE;
+    List<org.opentripplanner.street.model.edge.StreetEdge> found = new ArrayList<>();
+    for (Edge e : graph.findEdges(env, org.opentripplanner.street.Scope.PERMANENT)) {
+      if (
+        !(e instanceof org.opentripplanner.street.model.edge.StreetEdge street) ||
+        !street.canTraverse(WALK_ONLY) ||
+        !street.isReachableFromGraph() ||
+        LinkAvoidance.isAvoided(street)
+      ) {
+        continue;
+      }
+      double d = distanceToLine(v.getLat(), v.getLon(), street.getGeometry(), xscale);
+      if (d > reach) {
+        continue;
+      }
+      if (d < best - 0.001) {
+        best = d;
+        found.clear();
+        found.add(street);
+      } else if (d <= best + 0.001) {
+        found.add(street);
+      }
+    }
+    if (found.isEmpty()) {
+      return false;
+    }
+    Set<StreetVertex> vertices = vertexLinker.linkToSpecificStreetEdgesPermanently(
+      v,
+      WALK_ONLY,
+      LinkingDirection.BIDIRECTIONAL,
+      Set.copyOf(found)
+    );
+    vertices.forEach(linkEdges::apply);
+    return !vertices.isEmpty();
+  }
+
+  private static double metres(double lat1, double lon1, double lat2, double lon2) {
+    double x = (lon2 - lon1) * 111320.0 * Math.cos(Math.toRadians(lat1));
+    double y = (lat2 - lat1) * 110540.0;
+    return Math.hypot(x, y);
+  }
+
+  private static double distanceToLine(
+    double lat,
+    double lon,
+    org.locationtech.jts.geom.LineString line,
+    double xscale
+  ) {
+    double px = lon * 111320.0 * xscale;
+    double py = lat * 110540.0;
+    double best = Double.MAX_VALUE;
+    var cs = line.getCoordinates();
+    for (int i = 0; i + 1 < cs.length; i++) {
+      double ax = cs[i].x * 111320.0 * xscale, ay = cs[i].y * 110540.0;
+      double bx = cs[i + 1].x * 111320.0 * xscale, by = cs[i + 1].y * 110540.0;
+      double dx = bx - ax, dy = by - ay, len2 = dx * dx + dy * dy;
+      double t = len2 == 0 ? 0 : Math.max(0, Math.min(1, ((px - ax) * dx + (py - ay) * dy) / len2));
+      best = Math.min(best, Math.hypot(px - (ax + t * dx), py - (ay + t * dy)));
+    }
+    return best;
+  }
