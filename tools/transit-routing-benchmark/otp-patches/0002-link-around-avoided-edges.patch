+package org.opentripplanner.street.model.edge;
+
+import java.util.Collections;
+import java.util.IdentityHashMap;
+import java.util.Set;
+
+/**
+ * nextroute patch (graph build only, never serialized): street edges a stop or an entrance should
+ * not depend on alone — flyovers, underpasses and other layers, service roads (parking aisles,
+ * driveways), bus lanes, cycleways, steps and building passages. OTP links a stop to its nearest
+ * edge only; when that edge is one of these, the walk to the pavement right beside the stop goes
+ * around (한강진 블루스퀘어 stop: 1.4 km for 0.35 km, nextroute #620). The OSM module marks the edges,
+ * splits inherit the mark, and after island pruning such stops get one more link to the nearest
+ * ordinary street.
+ */
+public final class LinkAvoidance {
+
+  private static final Set<StreetEdge> AVOIDED = Collections.synchronizedSet(
+    Collections.newSetFromMap(new IdentityHashMap<>())
+  );
+
+  private LinkAvoidance() {}
+
+  public static void mark(StreetEdge edge) {
+    if (edge != null) {
+      AVOIDED.add(edge);
+    }
+  }
+
+  public static boolean isAvoided(Edge edge) {
+    return edge instanceof StreetEdge && AVOIDED.contains(edge);
+  }
+
+  static void inherit(StreetEdge parent, SplitStreetEdge split) {
+    if (AVOIDED.contains(parent)) {
+      mark(split.head());
+      mark(split.tail());
+    }
+  }
+
+  public static int size() {
+    return AVOIDED.size();
+  }
+}
