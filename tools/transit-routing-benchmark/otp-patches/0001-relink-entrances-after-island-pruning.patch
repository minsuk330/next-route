+  /**
+   * Link the entrances again after island pruning. Pruning takes pedestrian access away from the
+   * edges of small street islands and re-links the stops that stood on them, but entrances keep
+   * their links to those dead edges and can no longer be reached from the street. A station whose
+   * platforms are only reachable through pathways then loses the exits that were linked to an
+   * island (nextroute #601).
+   */
+  public void relinkTransitEntrances(Graph graph) {
+    for (TransitEntranceVertex tEntrance : graph.getVerticesOfType(TransitEntranceVertex.class)) {
+      List<Edge> links = new java.util.ArrayList<>();
+      for (Edge e : tEntrance.getOutgoing()) {
+        if (e instanceof StreetTransitEntranceLink) {
+          links.add(e);
+        }
+      }
+      for (Edge e : tEntrance.getIncoming()) {
+        if (e instanceof StreetTransitEntranceLink) {
+          links.add(e);
+        }
+      }
+      links.forEach(graph::removeEdge);
+    }
+    linkTransitEntrances(graph);
+  }
+
