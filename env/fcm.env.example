# 여정 알림 push 발송(FCM) 설정 — worker 컨테이너 전용.
# 실제 값은 env/fcm.env 에 넣는다(gitignore 대상, 커밋 금지).
#
#   cp env/fcm.env.example env/fcm.env
#
# API 컨테이너에는 주지 않는다. relay 는 worker 프로필에서만 돌고, API 에 자격증명을 주면
# 권한만 넓어지는 데다 Firebase 초기화 실패가 API 부팅까지 막는다.

# 발송 구현. noop 이면 아무 데도 안 보낸다(기본값).
# ⚠ 켜는 순서: 자격증명 배치 → worker 만 fcm → 부팅 확인 → 그 다음에 relay 를 켠다.
#   ⑤(발송 직전 재검증)와 ⑥(payload 계약) 전에는 relay 를 켜지 않는다.
JOURNEY_NOTIFICATION_SENDER=fcm

# 서비스 계정 JSON 의 컨테이너 안 경로.
# 호스트의 파일을 읽기 전용 볼륨으로 마운트한다(compose.yaml 의 worker 서비스).
# base64 로 환경변수에 통째로 넣는 방식은 쓰지 않는다 — 프로세스 목록과 크래시 덤프에 남는다.
FIREBASE_CREDENTIALS_PATH=/secrets/firebase-service-account.json

# 발송 스위치. 이 PR 시점의 기본은 꺼짐이다(행은 쌓이고 아무것도 안 나간다).
JOURNEY_NOTIFICATION_RELAY_ENABLED=false
