# 자체 인증(JWT) + 운영 Admin API 설정
# 이 파일은 예시다. 실제 값은 env/auth.env 에 넣는다(gitignore 대상, 커밋 금지).
# 변수명은 application.yaml 의 ${...} 플레이스홀더와 정확히 일치해야 한다.
#
#   cp env/auth.env.example env/auth.env
#   그 뒤 AUTH_JWT_SECRET 을 아래 방법으로 생성해 채운다.

# ── JWT 서명 시크릿 ──────────────────────────────────────────────────────────
# HMAC-SHA256 서명 키. 이 값을 아는 사람은 임의의 사용자로 위조 토큰을 만들 수 있다.
# 소스·이미지·로그 어디에도 남기지 않는다. 기본값을 두지 않는 이유이기도 하다.
#
# 최소 32자(256bit) 이상이어야 한다. 짧으면 부팅 시 명시적으로 실패한다.
# 생성:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   openssl rand -base64 48 | tr -d '\n'
#
# 유출됐다면 이 값을 교체한다. 교체하면 발급된 모든 access·refresh 토큰이
# 즉시 무효가 되므로 전체 사용자가 재로그인해야 한다.
AUTH_JWT_SECRET=replace-me-with-a-generated-value-at-least-32-chars

# 토큰 발급자. 검증 시 이 값과 일치하지 않으면 거부한다.
AUTH_JWT_ISSUER=nextroute

# access 토큰 유효시간(초). 기본 1시간.
AUTH_JWT_ACCESS_TTL=3600

# refresh 토큰 유효시간(초). 기본 14일.
AUTH_JWT_REFRESH_TTL=1209600

# ── 운영 Admin API ───────────────────────────────────────────────────────────
# /api/admin/** 보호 시크릿. ops 가 X-Admin-Key 헤더로 인증한다.
# 비우면 admin 엔드포인트가 전부 401 로 닫힌다(fail-closed).
ADMIN_API_KEY=
