# 앱 OAuth provider 설정 (Apple / Kakao)
# 실제 값은 env/oauth.env 에 넣는다(gitignore 대상, 커밋 금지).
# 변수명은 application.yaml 의 ${...} 플레이스홀더와 정확히 일치해야 한다.
#
#   cp env/oauth.env.example env/oauth.env
#
# 아직 콘솔 발급을 받지 않았다면 placeholder 그대로 두어도 앱은 뜬다.
# 다만 실제 로그인은 검증 단계에서 실패한다 — 값이 진짜가 아니기 때문이다.
# 단위 테스트는 자체 생성 키와 MockWebServer 를 쓰므로 이 값에 의존하지 않는다.

# ── Apple ────────────────────────────────────────────────────────────────────
# 허용할 대상 앱 식별자. iOS 는 Bundle ID.
# Android 에서도 애플 로그인을 제공하면 Service ID 를 쉼표로 덧붙인다(값이 다르다).
OAUTH_APPLE_AUDIENCES=com.golbob.nextroute

# ── Kakao ────────────────────────────────────────────────────────────────────
# 카카오 토큰은 불투명 문자열이라 애플처럼 안을 열어 대상 앱을 볼 수 없다.
# 그래서 서버가 두 번 물어본다.
#   ① access_token_info → app_id 가 우리 앱인지 대조 (애플의 aud 검사에 해당)
#   ② user/me           → 이메일·닉네임 (표시용)
#
# app_id 를 비우면 다른 앱이 발급받은 토큰도 통과하므로 기동을 막는다.
# 카카오 개발자 콘솔 > 앱 설정 > 요약 정보에서 확인할 수 있다.
#
# 아래는 자리표시자다. 이 값으로도 앱은 뜨지만 카카오 로그인은 전부 거부된다
# (실제 토큰의 app_id 와 다르므로). 발급받으면 반드시 교체한다.
OAUTH_KAKAO_APP_ID=999999999

OAUTH_KAKAO_TOKEN_INFO_URI=https://kapi.kakao.com/v1/user/access_token_info
OAUTH_KAKAO_USER_INFO_URI=https://kapi.kakao.com/v2/user/me
