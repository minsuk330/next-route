# 복사: cp grafana.env.example grafana.env  후 값 수정. grafana.env는 gitignore됨(커밋 금지).
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false
GF_SERVER_ROOT_URL=https://grafana.refit-100.site
# 장애 알림 Slack Incoming Webhook (grafana/provisioning/alerting/contact-points.yaml 가 참조). 비밀값 — 커밋 금지.
SLACK_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME
# alert-analyzer webhook 연동 Bearer 토큰. env/alert-analyzer.env 와 같은 값(openssl rand -hex 32). 비밀값 — 커밋 금지.
ANALYZER_WEBHOOK_TOKEN=CHANGE_ME
