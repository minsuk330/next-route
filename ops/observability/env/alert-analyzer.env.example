# 복사: cp alert-analyzer.env.example alert-analyzer.env 후 값 수정. alert-analyzer.env 는 gitignore(커밋 금지).
# Grafana webhook 연동과 같은 값(grafana.env 의 ANALYZER_WEBHOOK_TOKEN). 예: openssl rand -hex 32
ANALYZER_WEBHOOK_TOKEN=CHANGE_ME
# true 면 맥락만 수집해 로그로 남긴다(LLM·Slack 호출 없음).
# false 면 아래 세 값이 모두 있어야 기동한다.
ANALYZER_DRY_RUN=true
ANALYZER_DAILY_LIMIT=30
# Claude Developer Platform 콘솔에서 발급한 API 키(사용량 과금). 대화·커밋에 붙이지 말 것
ANTHROPIC_API_KEY=
# Slack 앱 Bot token(xoxb-…). 권한 chat:write, channels:history, groups:history, reactions:read(주간 요약 채점)
SLACK_BOT_TOKEN=
# 알림 채널 ID(C…). 봇을 이 채널에 초대해야 한다
SLACK_CHANNEL_ID=

# --- 주간 요약(python -m analyzer.weekly, VPS cron 월 09:00) ---
# Grafana 서비스 계정(Viewer) 토큰. Postgres 를 Grafana /api/ds/query 로 읽는다(분석기는 DB 접속 없음).
GRAFANA_API_TOKEN=
# 선택: observability-weekly 열린 issue 수. 저장소 issues 읽기 권한만 있는 fine-grained 토큰. 비우면 그 줄 생략
GITHUB_TOKEN=
