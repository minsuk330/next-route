# 복사: cp alert-analyzer.env.example alert-analyzer.env 후 값 수정. alert-analyzer.env 는 gitignore(커밋 금지).
# Grafana webhook 연동과 같은 값(grafana.env 의 ANALYZER_WEBHOOK_TOKEN). 예: openssl rand -hex 32
ANALYZER_WEBHOOK_TOKEN=CHANGE_ME
# true 면 맥락만 수집해 로그로 남긴다(LLM·Slack 호출 없음). 현재는 true 만 지원.
ANALYZER_DRY_RUN=true
ANALYZER_DAILY_LIMIT=30
